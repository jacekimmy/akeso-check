{
  "name": "akeso-check",
  "version": "0.1.0",
  "description": "Prove whether your app grants and revokes paid access correctly. Runs on your machine; nothing leaves it.",
  "type": "module",
  "bin": { "akeso-check": "bin/akeso-check.mjs" },
