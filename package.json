  "keywords": ["stripe", "billing", "webhooks", "subscriptions", "entitlement", "saas", "testing"],
  "engines": { "node": ">=20" },
  "scripts": {
    "check": "node bin/akeso-check.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
